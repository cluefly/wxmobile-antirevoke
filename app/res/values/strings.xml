    <string name="app_name">DSport</string>
    <string name="header">DSport</string>
    <string name="subtitle">通用页是这台手机上的原始读数。偏移加在系统计步服务和微信的 step_counter 累计值上。</string>
    <string name="tab_general">通用</string>
    <string name="tab_wechat">微信</string>
    <string name="wechat_title">微信服务端配置</string>
    <string name="wechat_waiting">正在读取主用户的微信运动配置。</string>
    <string name="wechat_refresh">重新读取</string>
    <string name="wechat_stop">停止微信</string>
    <string name="wechat_start">启动微信</string>
    <string name="wechat_apply">覆盖通用页上限</string>
    <string name="anti_revoke">防撤回</string>
    <string name="anti_revoke_hint">别人撤回时，这台手机已经收到的消息保持原样，并在它下面补一条红色的「已撤回」提示。自己发出的撤回照常显示。公众号不处理。</string>
    <string name="counter_title">计步器</string>
    <string name="counter_type">android.sensor.step_counter</string>
    <string name="detector_title">步数检测</string>
    <string name="detector_type">android.sensor.step_detector</string>
    <string name="minute_title">厂商分钟计步</string>
    <string name="minute_type">qti.sensor.pedometer_minute</string>
    <string name="waiting">等待数据</string>
    <string name="detector_count_initial">本次打开后触发 0 次</string>
    <string name="minute_seq_initial">序号 values[1] —（不修改）</string>
    <string name="minute_extra_initial">其他：等待数据</string>
    <string name="hook_initial">系统服务侧：还没有回调</string>
    <string name="time_initial">收到时间 —</string>
    <string name="edit_title">修改累计步数</string>
    <string name="edit_body">只改 step_counter 的累计值。步数只增不减，不能填负数。开关打开时，输入的是累计目标；低于已计入的数字不会把步数减回去。开关关闭再保存时，输入的是在已计入步数上再增加的数量，按同样的每分钟、每 5 分钟规则继续加，已经加上的步数保留。步数上限默认 18000，送出的累计值达到上限后不再增加。到达每 5 分钟那个数时微信会丢掉这一截，所以实际停在它减 1。</string>
    <string name="step_cap_hint">步数上限</string>
    <string name="rate_minute_hint">每分钟上限</string>
    <string name="rate_five_hint">每 5 分钟上限</string>
    <string name="switch_label">启用累计值偏移</string>
    <string name="offset_hint">目标累计步数，不能为负数</string>
    <string name="offset_add_hint">在已计入步数上再增加</string>
    <string name="save">保存</string>
